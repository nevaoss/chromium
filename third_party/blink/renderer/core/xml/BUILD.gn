import("//third_party/blink/renderer/core/core.gni")

# Chromium-style plugin produces an error for xpath_grammar_generated.h.
# Disable the plugin for sources including xpath_grammar_generated.h.
# Bison-generated code is not compatible with unsafe_buffers.
blink_core_sources("xpath_generated") {
  sources = [
    "xpath_grammar_generated.cc",
    "xpath_grammar_generated.h",
    "xpath_parser.cc",
  ]
  if (is_clang) {
    # TODO(neva): unsafe-buffers checks are excluded in
    # build/config/BUILDCONFIG.gn until it will be properly configured in the
    # upstream. Otherwise many errors occurs on Jenkins (without ICECC).
    # Temporary include it here to avoid configuration error.
    configs += [ "//build/config/clang:unsafe_buffers", ]
    configs -= [
      "//build/config/clang:find_bad_constructs",
      "//build/config/clang:unsafe_buffers",
    ]
  }
}
