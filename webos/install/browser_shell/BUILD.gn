import("//neva/app_runtime/app_runtime_locales.gni")
import("//neva/neva.gni")
import("//webos/install/cbe.gni")
import("//webos/install/paths.gni")
import("//webos/install/sysbus.gni")
import("//webos/install/weboswebruntime/common_resources.gni")

install_manifest("browser_shell_manifest") {
  sources = [ "browser-shell.manifest.json" ]
}

install_containers("browser_shell_container") {
  sources = [ "//webos/install/services/app.container.json.in" ]
  exename = "$browser_shell_exe"
  app = "$browser_shell_app"
}

install_client_permissions("browser_shell_permissions") {
  sources = [ "browser-shell.perm.json" ]
}

install_templated_roles("browser_shell_roles") {
  sources = [ "browser-shell.role.json.in" ]
  exename = "$browser_shell_exe"
  app = "$browser_shell_app"
}

install_run_script("browser_shell_run_script") {
  sources = [ "run_browser_shell.in" ]
  injections = [
    "v8/browser_shell",
    "v8/launchpoint",
    "v8/memorymanager"
  ]

  if (use_neva_chrome_extensions) {
    injections += [ "v8/chrome_extensions" ]
  }

  outputs = [ "$image_path/$browser_shell_dir/run_browser_shell" ]
}

# TODO(Neva): Please consider refactoring with the common resources in
# webos/install/browser_shell/BUILD.gn.
copy("weboswebruntime") {
  sources = weboswebruntime_resources

  outputs = [ "$image_path/$browser_shell_data_dir/{{source_file_part}}" ]

  deps = [
    "//neva/app_runtime:app_runtime_resources", # for app_runtime_content.pak
    "//third_party/icu:icudata",                # for icudtl.dat
    "//v8:v8",                                  # for snapshot_blob.bin
    "//webos:webos_resources",                  # for webos_content.pak
  ]
}

# TODO(Neva): Please consider refactoring with the common resources in
# webos/install/browser_shell/BUILD.gn.
copy("locales") {
  sources = weboswebruntime_locales

  foreach(locale, app_runtime_locales) {
    sources += [ "$root_gen_dir/webos/repack/$locale.pak" ]
  }

  outputs = [ "$image_path/$browser_shell_data_locales_dir/{{source_file_part}}" ]
  deps = [
    "//third_party/blink/public/strings",
    "//webos:resources",
  ]
}

# TODO(Neva): Please consider refactoring with the common resources in
# webos/install/browser_shell/BUILD.gn.
copy("gl") {
  sources = weboswebruntime_gl_resources

  outputs = [ "$image_path/$browser_shell_data_dir/{{source_file_part}}" ]
  deps = [
    "//ui/gl:generate_angle_stubs",
    "//third_party/angle:libEGL",
    "//third_party/angle:libGLESv2",
  ]
}

copy("browser_shell") {
  sources = [ "$root_out_dir/browser_shell_webos" ]
  outputs = [ "$image_path/$browser_shell_exe" ]

  deps = [
    "//webos/browser_shell:browser_shell_webos",
    ":browser_shell_container",
    ":browser_shell_manifest",
    ":browser_shell_permissions",
    ":browser_shell_roles",
    ":browser_shell_run_script",
  ]

  if (!use_cbe || !is_browser_shell_cbe) {
    deps += [
      ":weboswebruntime",
      ":locales",
      ":gl",
    ]
  }
}
