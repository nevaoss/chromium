import("//neva/app_runtime/app_runtime_locales.gni")
import("//neva/neva.gni")
import("//webos/install/paths.gni")
import("//webos/install/sysbus.gni")
import("//webos/install/weboswebruntime/common_resources.gni")

copy("wam_demo_cursor") {
  sources = [ "$root_out_dir/cursor.png" ]
  outputs = [ "$image_path/$wam_demo_dir/cursor.png" ]

  deps = [
    "//neva/wam_demo:cursor"
  ]
}

copy("wam_demo_error_pages") {
  sources = [ "$root_out_dir/wam_demo_network_error_page.html" ]
  outputs = [ "$image_path/$wam_demo_dir/wam_demo_network_error_page.html" ]

  deps = [ "//neva/wam_demo:error_pages" ]
}

install_containers("wam_demo_container") {
  sources = [ "//webos/install/services/app.container.json.in" ]
  exename = "$wam_demo_exe"
  app = "$wam_demo_app"
}

install_manifest("wam_demo_manifest") {
  sources = [
    "com.webos.app.wam-demo.manifest.json",
    "com.webos.app.neva.wam.demo.manual.manifest.json",
  ]
}

install_templated_roles("wam_demo_roles") {
  sources = [ "com.webos.app.wam-demo.role.json.in" ]
  exename = "$wam_demo_exe"
  app = "$wam_demo_app"
}

install_client_permissions("wam_demo_perm") {
  sources = [
    "com.webos.app.neva.wam.demo.manual.perm.json",
    "com.webos.app.wam-demo.perm.json"
  ]
}

install_preprepared_roles("wam_demo_manual_role") {
  sources = [ "com.webos.app.neva.wam.demo.manual.role.json" ]
}

install_scripts("wam_demo_scripts") {
  sources = [ "run_wam_demo" ]
  outputs = [ "$image_path/$wam_demo_dir/run_wam_demo" ]
}

copy("weboswebruntime") {
  sources = weboswebruntime_resources

  outputs = [ "$image_path/$wam_demo_data_dir/{{source_file_part}}" ]

  deps = [
    "//neva/app_runtime:app_runtime_resources", # for app_runtime_content.pak
    "//third_party/icu:icudata",                # for icudtl.dat
    "//v8:v8",                                  # for snapshot_blob.bin
    "//webos:webos_resources",                  # for webos_content.pak
  ]
}

copy("locales") {
  sources = weboswebruntime_locales

  foreach(locale, app_runtime_locales) {
    sources += [ "$root_gen_dir/webos/repack/$locale.pak" ]
  }

  outputs = [ "$image_path/$wam_demo_data_locales_dir/{{source_file_part}}" ]
  deps = [
    "//third_party/blink/public/strings",
    "//webos:resources",
  ]
}

copy("wam_demo") {
  sources = [ "$root_out_dir/wam_demo" ]
  outputs = [ "$image_path/$wam_demo_dir/{{source_file_part}}" ]

  deps = [
    "//neva/wam_demo:wam_demo",
    ":wam_demo_scripts",
    ":wam_demo_perm",
    ":wam_demo_manual_role",
    ":wam_demo_container",
    ":wam_demo_cursor",
    ":wam_demo_error_pages",
    ":wam_demo_manifest",
    ":wam_demo_roles",
  ]

  if (!use_cbe || !is_wam_demo_cbe) {
    deps += [
      ":weboswebruntime",
      ":locales",
    ]
  }
}
