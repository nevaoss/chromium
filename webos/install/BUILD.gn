import("//neva/neva.gni")
import("//ui/ozone/ozone.gni")

group("install") {
  testonly = true

  deps = [
    "weboswebruntime",
    "wam_demo",
    "browser_shell",
    "default_browser",
    "chromedriver",
    "unit_tests"
  ]

  if (enable_app_shell) {
    deps += [ "app_shell" ]
  }

  if (webos_product_type != "tv" && webos_product_type != "signage") {
    deps += [ "error_page_permission" ]
  }
}
