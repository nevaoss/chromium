module browser_shell.mojom;

interface SiteSettingsClient {
   OnUpdate();
};

struct Permission {
  string type;
  string setting;
};

interface SiteSettings {
  RegisterClient(pending_associated_remote<SiteSettingsClient> remote);
  GetAllSites() => (array<string> sites);
  GetSitesForSettingType(string type) => (array<string> sites);
  GetOriginPermissions(string origin, array<string> types) => (array<Permission> permissions);
  ResetOriginPermissions(string origin, array<string> types);
};
