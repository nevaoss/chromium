+++ mod.rs	2026-01-20 11:50:11.595527389 +0300
@@ -448,12 +448,13 @@
             modifiers = "-bundle",
             cfg(target_feature = "crt-static")
         )]
-        #[link(
-            name = "dl",
-            kind = "static",
-            modifiers = "-bundle",
-            cfg(target_feature = "crt-static")
-        )]
