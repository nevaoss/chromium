From: German Cvetkov <german.cvetkov@lge.com>
Date: Fri, 21 Aug 2026 15:23:41 +0300
Subject: [PATCH] [TagName] Draft dfskjglsdk

Issue:
---
 BUILD.gn                     |  5 ++++-
 include/libyuv/compare_row.h |  4 ++++
 include/libyuv/row.h         |  4 ++++
 source/compare_neon64.cc     |  4 ++--
 source/row_neon64.cc         | 24 ++++++++++++------------
 5 files changed, 26 insertions(+), 15 deletions(-)

diff --git a/BUILD.gn b/BUILD.gn
index d3fbd33e..b55d41b1 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -9,6 +9,7 @@
 import("//build/config/features.gni")
 import("//testing/test.gni")
 import("libyuv.gni")
+import("//neva/neva.gni")
 
 declare_args() {
   # Set to false to disable building with absl flags.
@@ -230,7 +231,9 @@ if (libyuv_use_neon) {
       use_libcxx_modules = false
 
       # TODO(thakis): Do we get this from global flags already? Is this needed?
-      cflags = [ "-march=armv8-a+dotprod+i8mm" ]
+       if (!is_webos) {
+       cflags = [ "-march=armv8-a+dotprod+i8mm" ]
+      }
     }
   }
 }
diff --git a/include/libyuv/compare_row.h b/include/libyuv/compare_row.h
index a08734e9..834633ea 100644
--- a/include/libyuv/compare_row.h
+++ b/include/libyuv/compare_row.h
@@ -61,8 +61,12 @@ extern "C" {
 #if !defined(LIBYUV_DISABLE_NEON) && defined(__aarch64__)
 #define HAS_HASHDJB2_NEON
 
+// TODO(neva): Remove this when webOS supports Neon DotProduct and I8MM
+// instructions.
+#if !defined(OS_WEBOS)
 #define HAS_HAMMINGDISTANCE_NEON_DOTPROD
 #define HAS_SUMSQUAREERROR_NEON_DOTPROD
++#endif  // !defined(OS_WEBOS)
 #endif
 
 uint32_t HammingDistance_C(const uint8_t* src_a,
diff --git a/include/libyuv/row.h b/include/libyuv/row.h
index 2cff1975..a1f44707 100644
--- a/include/libyuv/row.h
+++ b/include/libyuv/row.h
@@ -530,6 +530,9 @@ extern "C" {
 #define HAS_P410TOAR30ROW_NEON
 #define HAS_P410TOARGBROW_NEON
 
+// TODO(neva): Remove this when webOS supports Neon DotProduct and I8MM
+// instructions.
+#if !defined(OS_WEBOS)
 #define HAS_ABGRTOYJROW_NEON_DOTPROD
 #define HAS_ABGRTOYROW_NEON_DOTPROD
 #define HAS_ARGBGRAYROW_NEON_DOTPROD
@@ -542,6 +545,7 @@ extern "C" {
 #define HAS_ARGBCOLORMATRIXROW_NEON_I8MM
 #define HAS_ARGBTOUVMATRIXROW_NEON_I8MM
 #define HAS_ARGBTOUV444MATRIXROW_NEON_I8MM
+#endif  // !defined(OS_WEBOS)
 #endif
 
 // The following are available on AArch64 SVE platforms:
diff --git a/source/compare_neon64.cc b/source/compare_neon64.cc
index 36c5e575..e6a0847a 100644
--- a/source/compare_neon64.cc
+++ b/source/compare_neon64.cc
@@ -152,7 +152,7 @@ uint32_t HashDjb2_NEON(const uint8_t* src, int count, uint32_t seed) {
         "v17", "v18", "v19");
   return hash;
 }
-
+#if !defined(OS_WEBOS)
 uint32_t HammingDistance_NEON_DotProd(const uint8_t* src_a,
                                       const uint8_t* src_b,
                                       int count) {
@@ -214,7 +214,7 @@ uint32_t SumSquareError_NEON_DotProd(const uint8_t* src_a,
       : "memory", "cc", "v0", "v1", "v2", "v3", "v4", "v5");
   return sse;
 }
-
+#endif  // !defined(OS_WEBOS)
 #endif  // !defined(LIBYUV_DISABLE_NEON) && defined(__aarch64__)
 
 #ifdef __cplusplus
diff --git a/source/row_neon64.cc b/source/row_neon64.cc
index ced4193b..e69c3bb0 100644
--- a/source/row_neon64.cc
+++ b/source/row_neon64.cc
@@ -2792,7 +2792,7 @@ void ARGBToUV444MatrixRow_NEON(const uint8_t* src_argb,
         "v17", "v18", "v19", "v20", "v21", "v22", "v23", "v24", "v25", "v26",
         "v27", "v28");
 }
-
+#if !defined(OS_WEBOS)
 void ARGBToUV444MatrixRow_NEON_I8MM(const uint8_t* src_argb,
                                     uint8_t* dst_u,
                                     uint8_t* dst_v,
@@ -2830,7 +2830,7 @@ void ARGBToUV444MatrixRow_NEON_I8MM(const uint8_t* src_argb,
       : "cc", "memory", "v0", "v1", "v2", "v3", "v4", "v5", "v16", "v17",
         "v29");
 }
-
+#endif  // !defined(OS_WEBOS)
 // RGB to BT601 coefficients
 // UB   0.875 coefficient = 112
 // UG -0.5781 coefficient = -74
@@ -3153,7 +3153,7 @@ void ARGB4444ToUVRow_NEON(const uint8_t* src_argb4444,
 
   );
 }
-
+#if !defined(OS_WEBOS)
 // Process any of ARGB, ABGR, BGRA, RGBA, by adjusting the ArgbConstants layout.
 static void ARGBToUVMatrixRow_NEON_I8MM_Impl(const uint8_t* src,
                                              int src_stride,
@@ -3233,7 +3233,7 @@ void ARGBToUVMatrixRow_NEON_I8MM(const uint8_t* src_argb,
   ARGBToUVMatrixRow_NEON_I8MM_Impl(src_argb, src_stride_argb, dst_u, dst_v,
                                    width, c);
 }
-
+#endif  // !defined(OS_WEBOS)
 void RGB565ToYRow_NEON(const uint8_t* src_rgb565, uint8_t* dst_y, int width) {
   asm volatile(
       "movi        v24.16b, #25                  \n"  // B * 0.1016 coefficient
@@ -3366,7 +3366,7 @@ void ARGBToYMatrixRow_NEON(const uint8_t* src_argb,
       : "cc", "memory", "v0", "v1", "v2", "v3", "v4", "v5", "v16", "v17", "v18",
         "v19", "v20", "v21", "v22");
 }
-
+#if !defined(OS_WEBOS)
 void ARGBToYMatrixRow_NEON_DotProd(const uint8_t* src_argb,
                                    uint8_t* dst_y,
                                    int width,
@@ -3434,7 +3434,7 @@ void RGBToYMatrixRow_NEON(const uint8_t* src_rgb,
       : "cc", "memory", "v0", "v1", "v2", "v3", "v4", "v16", "v17", "v18",
         "v19", "v20", "v21");
 }
-
+#endif  // !defined(OS_WEBOS)
 // Bilinear filter 16x2 -> 16x1
 void InterpolateRow_NEON(uint8_t* dst_ptr,
                          const uint8_t* src_ptr,
@@ -3855,7 +3855,7 @@ void ARGBGrayRow_NEON(const uint8_t* src_argb, uint8_t* dst_argb, int width) {
 static const uvec8 kARGBGrayRowCoeffs = {29, 150, 77, 0};
 static const uvec8 kARGBGrayRowIndices = {0, 0, 0, 19, 2, 2, 2, 23,
                                           4, 4, 4, 27, 6, 6, 6, 31};
-
+#if !defined(OS_WEBOS)
 void ARGBGrayRow_NEON_DotProd(const uint8_t* src_argb,
                               uint8_t* dst_argb,
                               int width) {
@@ -3883,7 +3883,7 @@ void ARGBGrayRow_NEON_DotProd(const uint8_t* src_argb,
         [indices] "r"(&kARGBGrayRowIndices)  // %[indices]
       : "cc", "memory", "v0", "v1", "v2", "v3", "v24", "v25");
 }
-
+#endif  // !defined(OS_WEBOS)
 // Convert 8 ARGB pixels (32 bytes) to 8 Sepia ARGB pixels.
 //    b = (r * 35 + g * 68 + b * 17) >> 7
 //    g = (r * 45 + g * 88 + b * 22) >> 7
@@ -3928,7 +3928,7 @@ void ARGBSepiaRow_NEON(uint8_t* dst_argb, int width) {
 static const uvec8 kARGBSepiaRowCoeffs = {17, 68, 35, 0,  22, 88,
                                           45, 0,  24, 98, 50, 0};
 static const uvec8 kARGBSepiaRowAlphaIndices = {3, 7, 11, 15, 19, 23, 27, 31};
-
+#if !defined(OS_WEBOS)
 void ARGBSepiaRow_NEON_DotProd(uint8_t* dst_argb, int width) {
   asm volatile(
       "ld3r        {v20.4s, v21.4s, v22.4s}, [%[coeffs]] \n"
@@ -3965,7 +3965,7 @@ void ARGBSepiaRow_NEON_DotProd(uint8_t* dst_argb, int width) {
       : "cc", "memory", "v0", "v1", "v2", "v3", "v4", "v5", "v6", "v7", "v20",
         "v21", "v22", "v24", "v25", "v26", "v28", "v29", "v30");
 }
-
+#endif  // !defined(OS_WEBOS)
 // Tranform 8 ARGB pixels (32 bytes) with color matrix.
 // TODO(fbarchard): Was same as Sepia except matrix is provided.  This function
 // needs to saturate.  Consider doing a non-saturating version.
@@ -4027,7 +4027,7 @@ void ARGBColorMatrixRow_NEON(const uint8_t* src_argb,
       : "cc", "memory", "v0", "v1", "v2", "v3", "v4", "v5", "v6", "v7", "v16",
         "v17", "v18", "v19", "v22", "v23", "v24", "v25");
 }
-
+#if !defined(OS_WEBOS)
 void ARGBColorMatrixRow_NEON_I8MM(const uint8_t* src_argb,
                                   uint8_t* dst_argb,
                                   const int8_t* matrix_argb,
@@ -4083,7 +4083,7 @@ void ARGBColorMatrixRow_NEON_I8MM(const uint8_t* src_argb,
       : "cc", "memory", "v0", "v1", "v16", "v17", "v18", "v19", "v20", "v21",
         "v22", "v23", "v31");
 }
-
+#endif  // !defined(OS_WEBOS)
 // Multiply 2 rows of ARGB pixels together, 8 pixels at a time.
 void ARGBMultiplyRow_NEON(const uint8_t* src_argb,
                           const uint8_t* src_argb1,
