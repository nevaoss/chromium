 uint64_t Heap::external_memory_hard_limit() {
+#if defined(USE_NEVA_APPRUNTIME)
+  if (v8_flags.configure_heap_details) {
+    return limits()->external_memory_low_since_last_gc() +
+        limits()->external_allocation_hard_limit();
+  }
+#endif  // defined(USE_NEVA_APPRUNTIME)
   return limits()->external_memory_low_since_last_gc() +
          limits()->max_old_generation_size() / 2;
 }
@@ -1477,6 +1483,12 @@ uint64_t Heap::external_memory_limit_for_interrupt() {
 }
 
 uint64_t Heap::external_memory_soft_limit() {
+#if defined(USE_NEVA_APPRUNTIME)
+  if (v8_flags.configure_heap_details) {
+    return limits()->external_memory_low_since_last_gc() +
+          limits()->external_allocation_soft_limit();
+  }
+#endif  // defined(USE_NEVA_APPRUNTIME)
   return limits()->external_memory_low_since_last_gc() +
          kExternalAllocationSoftLimit;
 }
@@ -3679,6 +3691,13 @@ bool Heap::HasHighFragmentation() {
 
   // Fragmentation is high if committed > 2 * used + kSlack.
   // Rewrite the expression to avoid overflow.
+
+#if defined(USE_NEVA_APPRUNTIME)
+  if (v8_flags.configure_heap_details) {
+    return committed - used > used + limits()->high_fragmentation_slack();
+  }
+#endif  // defined(USE_NEVA_APPRUNTIME)
+
   return committed - used > used + kSlack;
 }
 
@@ -5140,6 +5159,64 @@ void Heap::ConfigureHeap(const v8::ResourceConstraints& constraints,
   configured_ = true;
 }
 
+#if defined(USE_NEVA_APPRUNTIME)
+void Heap::ConfigureHeapDetails(size_t min_allocation_limit_growing_step_size,
+                                size_t high_fragmentation_slack,
+                                int external_allocation_hard_limit_mb,
+                                int external_allocation_soft_limit_mb) {
+  if (limits()->configured_details()) return;
+
+  if (v8_flags.configure_heap_details) {
+    // Configure detailed constraints by flags
+    if (v8_flags.minimum_allocation_limit_growing_step_size) {
+      limits()->set_min_allocation_limit_growing_step_size(
+          v8_flags.minimum_allocation_limit_growing_step_size);
+    }
+    if (v8_flags.high_fragmentation_slack) {
+      limits()->set_high_fragmentation_slack(v8_flags.high_fragmentation_slack);
+    }
+    if (v8_flags.external_allocation_hard_limit > 0) {
+      limits()->set_external_allocation_hard_limit(
+          static_cast<uint64_t>(v8_flags.external_allocation_hard_limit * MB));
+    }
+    if (v8_flags.external_allocation_soft_limit > 0) {
+      limits()->set_external_allocation_soft_limit(
+          static_cast<uint64_t>(v8_flags.external_allocation_soft_limit * MB));
+    }
+  }
+
+  // Configure detailed constraints by each app
+  if (min_allocation_limit_growing_step_size)
+    limits()->set_min_allocation_limit_growing_step_size(
+        min_allocation_limit_growing_step_size);
+  if (high_fragmentation_slack)
+    limits()->set_high_fragmentation_slack(high_fragmentation_slack);
+  if (external_allocation_hard_limit_mb > 0) {
+    limits()->set_external_allocation_hard_limit(
+        static_cast<uint64_t>(external_allocation_hard_limit_mb * MB));
+  }
+  if (external_allocation_soft_limit_mb > 0) {
+    limits()->set_external_allocation_soft_limit(
+        static_cast<uint64_t>(external_allocation_soft_limit_mb * MB));
+  }
+
+  if (v8_flags.trace_configure_heap_details) {
+    PrintIsolate(
+        isolate_,
+        "MinAllocationLimitGrowingStepSize: %6zu"
+        ", high_fragmentation_slack_: %6zu"
+        ", external_allocation_hard_limit_: %d"
+        ", external_allocation_soft_limit: %d\n",
+        limits()->min_allocation_limit_growing_step_size(),
+        limits()->high_fragmentation_slack(),
+        static_cast<int>(limits()->external_allocation_hard_limit() / MB),
+        static_cast<int>(limits()->external_allocation_soft_limit() / MB));
+  }
+
+  limits()->set_configured_details(true);
+}
+#endif  // defined(USE_NEVA_APPRUNTIME)
+
 void Heap::AddToRingBuffer(const char* string) {
