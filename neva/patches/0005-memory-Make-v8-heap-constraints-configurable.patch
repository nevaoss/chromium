diff --git a/src/heap/heap-controller.cc b/src/heap/heap-controller.cc
index 621ef5c2254..fdb9ca02f36 100644
--- a/src/heap/heap-controller.cc
+++ b/src/heap/heap-controller.cc
@@ -140,11 +140,34 @@ double MemoryController<Trait>::DynamicGrowingFactor(
   return factor;
 }
 
+#if defined(USE_NEVA_APPRUNTIME)
+size_t V8HeapTrait::MinimumAllocationLimitGrowingStep(Heap* heap) {
+  size_t limit = (NormalPage::kPageSize > MB ? NormalPage::kPageSize : MB);
+  if (v8_flags.configure_heap_details)  {
+    if (v8_flags.trace_configure_heap_details) {
+      Isolate::FromHeap(heap)->PrintWithTimestamp("MinimumAllocationLimitGrowingStep: %6zu \n",
+                               limit * heap->limits()->min_allocation_limit_growing_step_size());
+    }
+    return limit * heap->limits()->min_allocation_limit_growing_step_size();
+  }
+  return kMinimumAllocationLimitGrowingStep;
+}
+#endif // defined(USE_NEVA_APPRUNTIME)
+
+#if defined(USE_NEVA_APPRUNTIME)
+size_t V8HeapTrait::BoundAllocationLimit(Isolate* isolate,
+                                         uint64_t current_size, uint64_t limit,
+#else
 size_t V8HeapTrait::BoundAllocationLimit(uint64_t current_size, uint64_t limit,
+#endif  // defined(USE_NEVA_APPRUNTIME)
                                          size_t min_size, size_t max_size,
                                          size_t new_space_capacity) {
   CHECK_LT(0, current_size);
+#if defined(USE_NEVA_APPRUNTIME)
+  limit = std::max(limit, current_size + MinimumAllocationLimitGrowingStep(isolate->heap())) +
+#else
   limit = std::max(limit, current_size + kMinimumAllocationLimitGrowingStep) +
+#endif  // defined(USE_NEVA_APPRUNTIME)
           new_space_capacity;
   const uint64_t halfway_to_the_max = (current_size + max_size) / 2;
   return base::saturated_cast<size_t>(
@@ -236,7 +259,11 @@ Heap::LimitsComputationResult HeapLimits::UpdateAllocationLimits(
   const size_t computed_old_generation_allocation_limit =
       old_gen_consumed_bytes_at_last_gc * v8_growing_factor;
   const size_t preliminary_old_generation_allocation_limit =
+#if defined(USE_NEVA_APPRUNTIME)
+      V8HeapTrait::BoundAllocationLimit(isolate(),
+#else
       V8HeapTrait::BoundAllocationLimit(
+#endif // defined(USE_NEVA_APPRUNTIME)
           old_gen_consumed_bytes_at_last_gc,
           computed_old_generation_allocation_limit, min_old_generation_size_,
           max_old_generation_size(), new_space_capacity);
@@ -306,6 +333,10 @@ Heap::LimitsComputationResult HeapLimits::UpdateAllocationLimits(
         dict.Add("external_growing_factor", external_growing_factor);
         dict.Add("external_memory_low_since_last_gc",
                  external_memory_low_since_last_gc());
+#if defined(USE_NEVA_APPRUNTIME)
