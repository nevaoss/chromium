:Issues Addressed:
[NEVA-9241] Upgrade neva-main-rolling up to 6483 BUILD
---
 BUILD.gn | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/BUILD.gn b/BUILD.gn
index a7001e6b0e2..81a743e43fb 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -15,6 +15,10 @@ import("//build_overrides/build.gni")
 import("gni/snapshot_toolchain.gni")
 import("gni/v8.gni")

+# TODO(neva): Restore to 'use_lld' condition when Neva GCC can remove use_gold
+# logic.
+import("//neva/neva.gni")
+
 # Specifies if the target build is a simulator build. Comparing target cpu
 # with v8 target cpu to not affect simulator builds for making cross-compile
 # snapshots.
@@ -7195,7 +7199,9 @@ if (current_toolchain == v8_snapshot_toolchain) {
       ldflags = [ "/OPT:NOICF" ]  # link.exe, but also lld-link.exe.
     } else if (is_apple && !use_lld) {
       ldflags = [ "-Wl,-no_deduplicate" ]  # ld64.
-    } else if (use_lld) {
+    # TODO(neva): Restore to 'use_lld' condition when Neva GCC can remove
+    # use_gold logic.
+    } else if (use_lld || (use_neva_appruntime && use_gold)) {
       ldflags = [ "-Wl,--icf=none" ]
     }
   }
