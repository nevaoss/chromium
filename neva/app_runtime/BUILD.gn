  }

  public_deps = [
    "//tools/v8_context_snapshot:v8_context_snapshot",
  ]

  sources += [ "$root_gen_dir/content/browser/devtools/devtools_resources.pak" ]
  deps += [ "//content/browser/devtools:devtools_resources" ]
